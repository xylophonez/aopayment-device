{erl_opts, [
    debug_info,
    {feature, maybe_expr, enable}
]}.

{deps, [
    {hb,
        {git, "https://github.com/permaweb/HyperBEAM.git",
            {ref, "178fec98d8f5ac3843534752d1047a8bed51df06"}}}
]}.

{plugins, [
