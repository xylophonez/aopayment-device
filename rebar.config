        {git_subdir, "https://github.com/permaweb/HyperBEAM.git",
            {ref, "178fec98d8f5ac3843534752d1047a8bed51df06"},
            "src/forge"}}
]}.

{shell, [{apps, [hb]}]}.

{eunit, [{apps, [hb]}]}.
